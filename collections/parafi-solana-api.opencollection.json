      "items": [
        {
          "info": {
            "name": "Get validator APY/APR with MEV contribution and status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://parafi.tech/api/solana/validator-apy",
            "params": [
              {
                "name": "epoch",
                "value": "",
                "type": "query",
                "description": "Override epoch for calculation (default: current)"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Bypass cache if true"
              }
            ]
          },
          "docs": "Get validator APY/APR with MEV contribution and status"
        },
